# ---------- API (apps/api) ----------
PORT=8787

# Database. Unset = local PGlite under ./data (no setup). Production: Supabase transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# PGLITE_PATH=./data/pglite

# Supabase Auth (parents and "Just me" users sign in here). Project settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Nebius Token Factory (https://tokenfactory.nebius.com): create an API key there.
NEBIUS_API_KEY=
# Optional overrides. Defaults are NVIDIA Nemotron 3 models on Token Factory:
#   fast (reflections, kid-safety checks on search results), agent (tool-calling agent, coach, quiz), reasoning (weekly insight).
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MODEL_AGENT=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_MODEL=   (sets all three at once, e.g. for a self-hosted OpenAI-compatible server; it must support tool calling)

# Tavily web search (https://app.tavily.com): kid-safe content ideas for tasks and sourced answers for parents.
# Unset = those features return 503 search_unavailable; everything else works.
TAVILY_API_KEY=

# Public URL phones use to fetch audio (defaults to the request origin)
# PUBLIC_URL=https://mello-api.example.com
# Where uploaded voice messages are stored. Container disks are wiped on redeploy; see docs/DEPLOY.md.
# UPLOAD_DIR=./data/audio

# Optional: Expo access token if you enable "enhanced push security" in your Expo account
# EXPO_ACCESS_TOKEN=

# ---------- Mobile app (apps/mobile), read at bundle time by Expo ----------
# The API URL as seen from the phone. Android emulator -> http://10.0.2.2:8787 ; real phone -> http://<your-computer-LAN-IP>:8787
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

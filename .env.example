# Nebius Token Factory (https://tokenfactory.nebius.com) - create an API key there.
NEBIUS_API_KEY=
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# API server
PORT=8787
# Public URL phones use to fetch audio (defaults to the request origin)
# PUBLIC_URL=https://mello-api.example.com
# DATABASE_PATH=./data/mello.db
# UPLOAD_DIR=./data/audio

# Optional: Expo access token if you enable "enhanced push security" in your Expo account
# EXPO_ACCESS_TOKEN=

# Mobile app (read at bundle time by Expo): the API URL as seen from the phone.
# Android emulator -> http://10.0.2.2:8787 ; real phone -> http://<your-computer-LAN-IP>:8787
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

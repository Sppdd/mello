<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets getInstalledApps() see launchable apps on Android 11+ without QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.melloblocker.MelloAccessibilityService"
      android:exported="false"
      android:label="@string/mello_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/mello_accessibility_service" />
    </service>
  </application>
</manifest>
